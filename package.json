{
  "name": "swades-hackathon-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/local-dev-entry.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/local-dev-entry.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "deploy": "vercel --prod"
  },
  "dependencies": {
    "@clerk/fastify": "^2.2.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/env": "^5.0.2",
    "@fastify/sensible": "^6.0.2",
    "axios": "^1.7.9",
    "close-with-grace": "^2.2.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.0.1",
    "mongoose": "^8.8.3",
    "pg": "^8.13.1",
    "pino-pretty": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "@vercel/node": "^5.1.6",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vercel": "^39.1.0"
  }
}
