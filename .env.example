# All values below are optional - the app boots and serves /health even
# with everything blank. Each integration only connects once its own var
# is filled in; until then it's skipped (see plugins/*.plugin.ts).
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Databases
DATABASE_URL=postgresql://user:password@localhost:5432/hackdb?sslmode=disable
MONGODB_URI=mongodb://localhost:27017/hackdb

# Clerk Auth
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Third-Party APIs
OPENROUTER_API_KEY=sk-or-...
UNSPLASH_ACCESS_KEY=...
PARALLEL_API_KEY=...
